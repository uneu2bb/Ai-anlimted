# Add only provider API keys you are authorized to use.
# The server tries providers in this order and falls back on quota/rate-limit/temporary errors.
# Each endpoint must be OpenAI-compatible (chat/completions).
AI_PROVIDERS_JSON=[
  {
    "name":"Groq",
    "baseUrl":"https://api.groq.com/openai/v1",
    "model":"llama-3.3-70b-versatile",
    "apiKeyEnv":"GROQ_API_KEY",
    "enabled":true
  },
  {
    "name":"OpenRouter",
    "baseUrl":"https://openrouter.ai/api/v1",
    "model":"deepseek/deepseek-chat",
    "apiKeyEnv":"OPENROUTER_API_KEY",
    "enabled":true
  }
]

GROQ_API_KEY=
OPENROUTER_API_KEY=
